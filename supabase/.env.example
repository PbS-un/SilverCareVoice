# ============================================================================
# SilverCare Voice — Supabase 環境變量樣板（T2 交付，目前不接 runtime）
# 複製為 .env 並填入實際值。啟用條件見 web/src/data/SupabaseProvider.ts 註釋。
#
# 安全規則：
#  - 前端只可使用 anon key（公開、受 RLS 保護）。
#  - service_role key 屬機密，絕不可寫進 web/ 代碼或提交到 git。
# ============================================================================

# Supabase project URL（Dashboard → Settings → API）
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon public key（僅 anon key！）
SUPABASE_ANON_KEY=your-anon-key-here

# 前端（Vite）專用變量名 —— 供 web/.env 使用，與上方同值
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
