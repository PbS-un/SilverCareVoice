# ============================================================================
# SilverCare Voice — Supabase 環境變量樣板（Task #8 更新：新版密鑰體系）
# 複製為 .env 並填入實際值。完整部署步驟見 supabase/DEPLOYMENT.md。
#
# 安全規則：
#  - 前端只可使用 publishable key（新版，sb_publishable_...；對應舊版
#    anon key，公開、受 RLS 保護）。
#  - secret key（新版，sb_secret_...；對應舊版 service_role key）屬機密，
#    絕不可寫進 web/ 代碼或提交到 git。
#  - sb_secret_ 完整值只能從 Dashboard → Project Settings → API Keys 複製，
#    本樣板與任何文檔一律只放佔位符。
# ============================================================================

# --- 前端（Vite）構建時變量 —— CI 與本機構建共用 --------------------------
# 注意：VITE_SUPABASE_URL 是 Edge Function 的【完整 base URL】，
# 不是專案 API 位址（https://gchpvuwgxaypiikyoxei.supabase.co）。
# CI 中等價於 GitHub repo Settings → Secrets and variables → Actions：
#   variable：VITE_SUPABASE_URL
#   secret　：VITE_SUPABASE_ANON_KEY（值為新版 publishable key；
#             屬公開層級，放 Variables 亦可，放 Secrets 同樣可行）
# 未設定時前端自動降級為純本地模式。
VITE_SUPABASE_URL=https://gchpvuwgxaypiikyoxei.functions.supabase.co/silvercare
VITE_SUPABASE_ANON_KEY=sb_publishable_wnP_Vn1v6PflT3GnjsZRSQ_fPz6ugwX

# 舊式直連專案位址（SupabaseProvider 備援用，與上不同：此為 supabase.co 專案 URL）
SUPABASE_URL=https://gchpvuwgxaypiikyoxei.supabase.co
# 新版密鑰體系下前端公開 key 的變數名；與 VITE_SUPABASE_ANON_KEY 同值
SUPABASE_ANON_KEY=sb_publishable_wnP_Vn1v6PflT3GnjsZRSQ_fPz6ugwX

# --- Edge Function secrets —— 只經 `supabase secrets set` 設定，勿入 git ----
# supabase secrets set DEEPSEEK_API_KEY=... SYNC_TOKEN=... SUPABASE_SERVICE_ROLE_KEY=<sb_secret_... 完整值>
#
# DEEPSEEK_API_KEY：AI 回覆引擎金鑰（/api/ai/chat 代理）
DEEPSEEK_API_KEY=sk-your-deepseek-key
#
# SYNC_TOKEN：sync 端點鑑權 + room 隔離（room = SHA-256(token) 前 16 hex）。
# 建議用 PowerShell 生成固定隨機字串（跨 shell 可用）：
#   -join ((48..57)+(97..122) | Get-Random -Count 32 | % {[char]$_})
# 評委第二裝置以 https://<pages-url>/?syncToken=<token> 配對。
SYNC_TOKEN=your-fixed-random-token
#
# SUPABASE_SERVICE_ROLE_KEY：Edge Function 內部寫 DB／發 Realtime 用（機密）。
# 新版密鑰體系下此處填入 sb_secret_... 完整值；亦可改用變數名
# SUPABASE_SECRET_KEY 設定（Edge Function 兩者皆讀，SUPABASE_SERVICE_ROLE_KEY
# 優先；新版專案平台自動注入的名稱即 SUPABASE_SECRET_KEY）。
SUPABASE_SERVICE_ROLE_KEY=sb_secret-your-secret-key-placeholder
