{
  "name": "silvercare-macau",
  "version": "0.1.0",
  "private": true,
  "description": "銀髮一句通 SilverCare Macau — 澳門長者 AI 慢病照護 Functional MVP (monorepo)",
  "type": "module",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web",
    "dev:server": "npm run dev --workspace server",
    "dev:all": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev\"",
    "build": "npm run build --workspace web",
    "preview": "npm run preview --workspace web",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace web",
    "test:e2e": "npm run test:e2e --workspace web",
    "pdf": "node scripts/generate-pdf.mjs",
    "video": "node scripts/generate-video.mjs",
    "pages": "node scripts/deploy-pages.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  }
}
