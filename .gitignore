# Dependencies
node_modules/

# Build outputs
dist/
build/
*.tsbuildinfo

# Env / secrets — 密鑰永不進 git
.env
.env.*
!.env.example
# 例外：web/.env.production 僅含公開層級配置（Supabase URL + publishable key，
# 設計上會進前端 bundle），須隨倉庫提交，確保生產 build 預設帶雲端模式
!web/.env.production

# SQLite databases
*.sqlite
*.sqlite3
*.db
server/data/

# Playwright artifacts
playwright-report/
test-results/
playwright/.cache/

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
