# ============================================================
# 銀髮一句通 SilverCare Macau — 環境變數範本
# 複製為 .env 後填入真實值。.env 已被 .gitignore 排除。
#
# 安全紅線：
#   1. 任何 API Key / Secret 只寫在 server 端的 .env，
#      「永不」放進前端程式碼，也「永不」使用 VITE_ 前綴
#      暴露密鑰給瀏覽器。
#   2. 前端僅透過 /api、/sync、/ws 代理與 server 通訊。
# ============================================================

# Server
PORT=8787

# AI 服務代理（server 端持有密鑰，前端只呼叫 /api 代理路由）
VITE_AI_PROXY_URL=
AI_API_KEY=

# 本地 SQLite 路徑（server 端）
DB_PATH=./data/silvercare.sqlite
